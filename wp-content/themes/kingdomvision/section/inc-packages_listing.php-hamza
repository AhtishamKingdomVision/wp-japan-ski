<script>
    jQuery(function($) {

        localStorage.setItem('niseko_hotel_search', 'false');

        let isResettingPrice = false;

        const PRICE_MIN = 0;
        const PRICE_MAX = 1000000;
        const GAP = 1000;
        let priceChanged = false;

        function lockResortFilter() {
                const segments = window.location.pathname
                    .split('/')
            .filter(Boolean); // removes empty parts

            const accIndex = segments.indexOf('accommodation');

        // Must exist AND must NOT be the first segment

            lockFilterIfScoped( 'resort' );
        }

        function getAccommodationAreaFromURL() {
                const segments = window.location.pathname
                .split('/')
                .filter(Boolean);

                if (segments.length >= 3 && segments[1] === 'accommodation') {
                return segments[2]; // area slug
            }

            return null;
        }

        function lockAccommodationArea() {
            const area = getAccommodationAreaFromURL();
            if (!area) return;

            // slug → input id (ski-in-ski-out → ski_in_ski_out)
            const inputId = area.replace(/-/g, '_');
            const $input = $('#' + inputId);

            // apply filters once
            $input.trigger('click');

            lockFilterIfScoped( inputId );
        }

    function lockFilterIfScoped( type ) {

        var filter_type = $(
            '.filter-tab[data-type="'+type+'"]'
            )

        if ( filter_type.length < 1 ){
            return;
        }

        const resortFilter = filter_type?.closest('.filter');

        if (!resortFilter) return;

        const closeBtn = resortFilter.find( '.close_filter' );
        if (closeBtn) closeBtn.remove();

        resortFilter.addClass('locked');
    }

    function updatePriceRange() {
        if (isResettingPrice) return;

        let min = parseInt($('#price_min').val(), 10);
        let max = parseInt($('#price_max').val(), 10);

        // Clamp instead of swap
        if (min > max - GAP) {
            min = max - GAP;
            $('#price_min').val(min);
        }

        if (max < min + GAP) {
            max = min + GAP;
            $('#price_max').val(max);
        }

        $('#price-min-label').text(min.toLocaleString('ja-JP'));
        $('#price-max-label').text(max.toLocaleString('ja-JP'));
    }

    // Listen to slider movement
    $('#price_min, #price_max').on('input change', function() {
        priceChanged = true;
        updatePriceRange();
    });



    function initSelectedFiltersFromInputs() {
        // Handle all checkboxes and radio buttons
        var selected_resort = $('.ch-item input[name="resort"]:checked ').siblings('label').text().trim().toLowerCase();
        
        get_base_area( selected_resort );
        $('.ch-item input:checked').each(function() {
            const $input = jQuery(this);
            const type = $input.attr('name').replace('[]', '');
            const value = $input.val();
            let label = $input.siblings('label').text().trim();

            // Add special handling for bedrooms
            if (type === 'bedrooms') {
                return;
            }

            const isRadio = $input.attr('type') === 'radio';

            upsertSelectedFilter({
                type,
                value,
                label,
                single: isRadio || type === 'price' || type === 'resort' // single-select filters
            });
        });

        // If price range is not default, add it as well
        const min = parseInt($('#price_min').val());
        const max = parseInt($('#price_max').val());
        const defaultMin = parseInt($('#price_min').attr('min'));
        const defaultMax = parseInt($('#price_max').attr('max'));

        if (min !== defaultMin || max !== defaultMax) {
            updatePriceFilter(min, max);
        }

        // Update Reset button visibility after initializing
        if( $( '.filter-tabs' ).length > 0 ){
            updateResetButtonVisibility();
            lockResortFilter();
            lockAccommodationArea();
        }
        $('#apply-filters').trigger( 'click' );
    }

    $(document).on('click', '.accordion-header', function(e) {
        e.preventDefault();

        const $accordion = $(this).closest('.filter-accordion');
        // Close all others
        $('.filter-accordion').not($accordion).removeClass('active');
        // Toggle this one
        $accordion.toggleClass('active');
    });

    function runSearch(page = 1, append = false) {

        const isHotelSearch = localStorage.getItem('niseko_hotel_search') === 'true';

        const per_page = $('#accom-search-form').attr('per_page') || 6;

        const checkin = $('input[name="checkin"]').val() || '';
        const checkout = $('input[name="checkout"]').val() || '';

        const resort = $('input[name="resort"]:checked').val() || '';
        const ski_in_ski_out = $('input[name="ski_in_ski_out"]:checked').val() || '';
        const booking = $('input[name="booking"]:checked').val() || '';
        const onsen = $('input[name="on-site"]:checked').val() || '';
        const discount = $('input[name="discount"]:checked').val() || '';

        if (checkin && checkout) {
            localStorage.setItem('niseko_checkin', checkin);
            localStorage.setItem('niseko_checkout', checkout);
        }

        /* ===============================
         * AREAS (checkbox)
         * =============================== */
        let areas = [];
        $('input[name="area[]"]:checked').each(function() {
            areas.push($(this).val());
        });

        var acc_data_type = $('input.acc_type_input:checked').val();

        /* ===============================
         * BEDROOMS (checkbox)
         * =============================== */
        let bedrooms = [];
        $('input[name="bedrooms[]"]:checked').each(function() {
            bedrooms.push($(this).val());
        });

        /* ===============================
         * ACCOMMODATION TYPE (checkbox)
         * =============================== */
        let accommodation_type = [];
        $('input[name="type[]"]:checked').each(function() {
            accommodation_type.push($(this).val());
        });

        if (!append) {
            $('#accom-search-results').html('<p>Loading...</p>');
        }

        // $('#accom-search-results').html('<p>Loading...</p>');

        $.ajax({
            url: '<?php echo admin_url('admin-ajax.php'); ?>',
            type: 'POST',
            data: {
                action: 'niseko_search',
                page: page,
                per_page: per_page,

                location: $('input[name="location"]').val() || '',
                // category_slug: $('.resort-filter').data('value') || '',
                // category_id: $('.resort-filter').length > 0 ? $('input[name="category_id"]').val() : '',

                checkin: checkin,
                checkout: checkout,
                guests: $('select[name="guests"]').val() || '1',

                acc_data_type: acc_data_type,
                resort: resort,
                onsen: onsen,
                ski_in_ski_out: ski_in_ski_out,
                booking: booking,
                discount: discount,
                hotel_search: isHotelSearch ? 1 : 0,

                bedrooms: bedrooms,
                accommodation_type: accommodation_type,
                areas: areas,

                sort: $('#sort-by').val() || '',
                price_min: priceChanged ? $('#price_min').val() : null,
                price_max: priceChanged ? $('#price_max').val() : null
            },

            beforeSend: function() {
                $('#rooms-count').text(0);
                $('#properties-count').text(0);
            },

            success: function(res) {
                if (res.success) {

                    if (append) {
                        $('#accom-search-results').append(res.data.html);
                    } else {
                        $('#accom-search-results').html(res.data.html);
                    }

                    $('#properties-count').text(res.data.count);
                    $('#rooms-count').text(res.data.room_count);

                    $('#load-more')
                    .prop('disabled', false)
                    .removeClass('loading')
                    .text('Load More');

                    if (res.data.has_more) {
                        $('#load-more').show().data('page', page);
                    } else {
                        $('#load-more').hide().data('page', 1);
                    }

                } else {
                    if (!append) {
                        $('#accom-search-results')
                        .html('<p class="no-results">No accommodation found.</p>');
                    }
                    $('#load-more').hide();
                }
            }
        });
    }

    $('#load-more').on('click', function() {
        const $btn = $(this);
        $btn
        .prop('disabled', true)
        .addClass('loading')
        .text('Loading…');

        let nextPage = $(this).data('page') + 1;
        runSearch(nextPage, true);
    });

    $('#accom-search-form').on('submit', function(e) {
        e.preventDefault();
        // Mark that this is a hotel/date search (RoomBoss)
        localStorage.setItem('niseko_hotel_search', 'true');
        runSearch(1, false);
    });

    // $('#sort-by').on('change', runSearch(1, false));

    /** Custom Sort Dropdown */

    const $sortDropdownWrapper = $('#sortDropdown');
    const $sortDropdownTrigger = $('#sortTrigger');
    const $sortDropdownMenu = $('#sortMenu');
    const $sortHiddenField = $('#sort-by');
    const $sortDropdownLabel = $('#sortLabel');

    /* ===============================
       TOGGLE SORT DROPDOWN
    =============================== */
    $sortDropdownTrigger.on('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        $sortDropdownWrapper.toggleClass('open');
    });

    /* ===============================
       SELECT SORT OPTION
    =============================== */
    $sortDropdownMenu.find('a').on('click', function(e) {
        e.preventDefault();

        const $selectedOption = $(this);
        const selectedValue = $selectedOption.data('value');
        const selectedText = $selectedOption.text();

        $sortHiddenField.val(selectedValue);
        $sortDropdownLabel.text(selectedText);

        $sortDropdownWrapper.removeClass('open');

        if (typeof runSearch === 'function') {
            runSearch(true); // reset pagination
        }
    });

    /* ===============================
       CLOSE ON OUTSIDE CLICK
    =============================== */
    $(document).on('click', function() {
        $sortDropdownWrapper.removeClass('open');
    });


    /** Custom Sort Dropdown */

    $(document).on('click', function(e) {

        // If click is inside filter panel OR open button → do nothing
        if (
            $(e.target).closest('#filter-panel').length ||
            $(e.target).closest('#open-filter').length
            ) {
            return;
    }

        // Otherwise close
    $('#filter-panel').removeClass('active');
});


    $('#open-filter').on('click', function() {
        $('#filter-panel').addClass('active');
    });

    $('#close-filter').on('click', function() {
        $('#filter-panel').removeClass('active');
    });

    $('#apply-filters').on('click', function() {
        $('#filter-panel').removeClass('active');
        runSearch(1, false);
    });

    $('#clear-filters').on('click', function() {

        $('.filter-tab.reset').trigger( 'click' );

    });


    /** Check in Checkout script */


    /* ===============================
    CHECK-IN
    =============================== */
    if ($('#sc-check-in').length === 1) {

    $('#sc-check-in')
        .addClass('dateDropper')
        .dateDropper({
            large: 1,
            largeDefault: 1,
            preset: false,
            minDate: kv_object.check_start_date,
            maxDate: kv_object.check_end_date,
            format: 'd-M-Y',
            eventSelector: 'click',

            onChange: function(res) {

                /* Inject helper text once */
                if (kv_object.date_dropper_content) {
                    const $picker = $('.datedropper .picker .pick-lg');
                    if ($picker.length && !$picker.find('.kv-text').length) {
                        $picker.prepend(
                            `<div class="kv-text">${kv_object.date_dropper_content}</div>`
                        );
                    }
                }

                // Create Date safely (NO string parsing)
                let dt = new Date(res.date.Y, res.date.m - 1, res.date.d);

                /* Enforce minimum nights */
                if (
                    kv_object.check_min_days_option === '1' &&
                    kv_object.check_min_days !== ''
                ) {
                    dt.setDate(
                        dt.getDate() + parseInt(kv_object.check_min_days, 10)
                    );
                }

                // Convert to d-M-Y
                let day   = ('0' + dt.getDate()).slice(-2);
                let month = dt.toLocaleString('en-US', { month: 'short' });
                let year  = dt.getFullYear();

                let minDate = day + '-' + month + '-' + year;

                /* Re-init CHECK-OUT */
                $('#sc-check-out')
                .prop('disabled', false)
                .dateDropper('destroy')
                .dateDropper({
                    large: 1,
                    largeDefault: 1,
                    minDate: minDate,
                    maxDate: kv_object.check_end_date,
                    format: 'd-M-Y',
                    eventSelector: 'click',
                    onChange: function() {

                        if (kv_object.date_dropper_content) {
                            const $picker = $('.datedropper .picker .pick-lg');
                            if ($picker.length && !$picker.find('.kv-text').length) {
                                $picker.prepend(
                                    `<div class="kv-text">${kv_object.date_dropper_content}</div>`
                                );
                            }
                        }
                    }
                });
            }
        });
    }


    /* ===============================
    CHECK-OUT (INITIAL STATE)
    =============================== */
    if ($('#sc-check-out').length === 1) {

    $('#sc-check-out')
        .prop('disabled', true)
        .addClass('dateDropper')
        .dateDropper({
            large: 1,
            largeDefault: 1,
            minDate: kv_object.check_start_date,
            maxDate: kv_object.check_end_date,
            format: 'd-M-Y',   // FIXED (was d/M/Y)
            eventSelector: 'click',
            onChange: function() {

                if (kv_object.date_dropper_content) {
                    const $picker = $('.datedropper .picker .pick-lg');
                    if ($picker.length && !$picker.find('.kv-text').length) {
                        $picker.prepend(
                            `<div class="kv-text">${kv_object.date_dropper_content}</div>`
                        );
                    }
                }
            }
        });
    }

    if (pathArray.filter(Boolean)[0] == 'accommodation') {
        $('.filter-accordion').addClass('active');
    }

    /* ===============================
       CLOSE PICKER ON DATE CLICK
    =============================== */
    $(document).on('mousedown', '.pick-lg li.pick-v', function() {
        $('#sc-check-in').dateDropper('hide');
        $('#sc-check-out').dateDropper('hide');
    });

    /** Check in Checkout script */

    // Only handle clicks on the close button
    $('.filter-tabs').on('click', '.close_filter', function () {
        const $filter = $(this).closest('.filter');
        const $tab = $filter.find('.filter-tab');
        const type = $tab.data('type');
        var apply_filter = localStorage.getItem( 'apply-filters' ) ?? localStorage.setItem( 'apply-filters', true );
        // Remove the filter element
        $filter.remove();

        // Reset price slider if price filter removed
        if (type === 'price') {
            const $min = $('#price_min');
            const $max = $('#price_max');

            const defaultMin = parseInt($min.attr('min'));
            const defaultMax = parseInt($max.attr('max'));

            // Update inputs
            $min.val(defaultMin);
            $max.val(defaultMax);

            $('#price-min-label').text( defaultMin );
            $('#price-max-label').text( defaultMax );
            // Call updatePriceFilter to sync and remove the tab
            updatePriceFilter(defaultMin, defaultMax);
        } else if (type === 'bedrooms'){
            // Reset checkboxes for bedrooms if needed
            $('input[name="bedrooms[]"]').prop('checked', false);
        } else {

            // Other filters: uncheck the input
            const val = $tab.data('value');
            
            console.log( 'in type' );
            console.log( type );
            
            console.log( 'in val' );
            console.log( val );

            console.log( 'in element' );
            console.log( $(`input[data-type="${type}"][value="${val}"]`) );

            $(`input[data-type="${type}"][value="${val}"]`).prop('checked', false);

            if( $(`input[data-type="${type}"][value="${val}"]`).is(':checked') ){
                console.log( 'in checked if' );
                $(`input[data-type="${type}"][value="${val}"]`).prop('checked', false);
            }
        }

        if( apply_filter == 'true' ){
            setTimeout(() => {
                $('#apply-filters').trigger('click');
            }, 200);
        }
    });

    $('.filter-tab.reset').on('click', function() {
        localStorage.setItem( 'apply-filters', false );
        
        $('.filter-tabs .close_filter').each( function ( i,e ){
            $(this).trigger('click');
        } );
        
        var parent = $( this ).parent('.filter');
        parent.hide();
        
        localStorage.setItem( 'apply-filters', true );

        localStorage.removeItem( 'niseko_checkin' );
        localStorage.removeItem( 'niseko_checkout' );
        
        $('#sc-check-in, #sc-check-out').val('');
        $('#apply-filters').trigger('click');
    });

    function getSelectedFilter(type, value = null) {
        const selector = value !== null
        ? `.filter-tab[data-type="${type}"][data-value="${value}"]`
        : `.filter-tab[data-type="${type}"]`;

        return document.querySelector(selector)?.closest('.filter') || null;
    }

    function updateResetButtonVisibility() {
        const selectedFiltersContainer = document.querySelector('.filter-tabs');
        const resetFilter = selectedFiltersContainer.querySelector('.filter-tab.reset')?.closest('.filter');

        if (!resetFilter) return;

        // Count filters excluding the reset button itself
        const activeFilters = selectedFiltersContainer.querySelectorAll(
            '.filter:has(.close_filter)'
            );

        if (activeFilters.length === 0) {
            resetFilter.style.display = 'none';
        } else {
            resetFilter.style.display = 'block';
        }
    }

    function upsertSelectedFilter({ type, value, label, single = false }) {
        const selectedFiltersContainer = document.querySelector('.filter-tabs');
        const filterTemplate = document.querySelector('#selected-filter-template .filter');

        if (!selectedFiltersContainer || !filterTemplate) return;

        let filterEl;

        if (single) {
            // SINGLE filter (price, resort, bedrooms)
            filterEl = selectedFiltersContainer.querySelector(
        `.filter-tab[data-type="${type}"]`
        )?.closest('.filter');
        } else {
            // MULTI filter (amenities, etc.)
            filterEl = selectedFiltersContainer.querySelector(
        `.filter-tab[data-type="${type}"][data-value="${value}"]`
        )?.closest('.filter');
        }

        // Create if it doesn't exist
        if (!filterEl) {
            filterEl = filterTemplate.cloneNode(true);

            // Find the reset tab if it exists
            const resetTab = selectedFiltersContainer.querySelector('.filter-tab.reset')?.closest('.filter');

            if (resetTab) {
                // Insert **before** the reset tab
                selectedFiltersContainer.insertBefore(filterEl, resetTab);
            } else {
                // Otherwise append normally
                selectedFiltersContainer.appendChild(filterEl);
            }
        }

        const tab = filterEl.querySelector('.filter-tab');

        // Update dataset
        tab.dataset.type = type;

        // Only set data-value when relevant
        if (value !== undefined && value !== null) {
            tab.dataset.value = value;
        } else {
            delete tab.dataset.value;
        }

        // Set label text
        tab.textContent = label;

        updateResetButtonVisibility();
    }


    function removeSelectedFilter(type, value = null) {
        const filterEl = getSelectedFilter(type, value);
        if (filterEl) filterEl.remove();

        updateResetButtonVisibility()
    }

    $('.ch-item input[name="resort"]').on('change', function () {
        var selected_resort = $(this).siblings('label').text().trim().toLowerCase();
        get_base_area( selected_resort );
        $().show();
    });

    $('.ch-item input[name="bedrooms[]"]').on('change', function () {
        const $input = $(this);

        const name = $input.attr('name');
        const type    = name.replace('[]', '');

        const value = $input.val();
        const isRadio = $input.attr('type') === 'radio';

        var bedroom_label = parseInt( value ) > 1 ? `${value} bedrooms` : `${value} bedroom`;

        if ($input.is(':checked')) {

            upsertSelectedFilter({
                type: 'bedrooms',
                value: value,
                label: bedroom_label,
                single: isRadio
            });

            $('.filter-tab.reset').show();
        } else{
            removeSelectedFilter( type, value );
        }

    });

    function updatePriceFilter(min, max) {

        min = parseInt(min);
        max = parseInt(max);

        const PRICE_DEFAULTS = {
            min: parseInt($('#price_min').attr('min')),
            max: parseInt($('#price_max').attr('max'))
        };

        // If price range is default → remove filter
        if (min === PRICE_DEFAULTS.min && max === PRICE_DEFAULTS.max) {
            removeSelectedFilter('price');
            return;
        }

        upsertSelectedFilter({
            type: 'price',
            value: `${min}-${max}`,
            label: `JPY ${min.toLocaleString()} – ${max.toLocaleString()}`,
            single: true   // 🔑 price must never duplicate
        });
    }

    function get_base_area(resort) {
        const baseAreas = {
            niseko: {
                izumikyo: "Izumikyo",
                kabayama: "Kabayama",
                "niseko-village": "Niseko Village / Higashiyama",
                hanazono: "Hanazono",
                "hirafu-village": "Hirafu Village",
            },
            hakuba: {
                "happo-village": "Happo One Village",
                wadano: "Happo One Wadano no Mori",
                echoland: "Echoland",
                misorano: "Misorano",
                hakuba47: "Hakuba 47",
                "hakuba-station": "Hakuba Station",
                goryu: "Goryu",
                iwatake: "Iwatake",
                tsugaike: "Tsugaike",
                norikura: "Norikura",
                cortina: "Cortina",
                ochikura: "Ochikura",
            },
            furano: {
                kitanomine: "Kitanomine Zone",
                furano: "Furano Zone",
            },
        };

        const container = document.querySelector(
            ".filter-accordion.base_area .accordion-content"
        );
        
        if (!container || !baseAreas[resort]) return;

        // reset previous content
        container.innerHTML = `<div class="checkbox-list"></div>`;

        const list = container.querySelector(".checkbox-list");
        
        Object.entries(baseAreas[resort]).forEach(([slug, label]) => {
            list.insertAdjacentHTML(
                "beforeend",
                `
                <div class="ch-item">
                    <input
                        type="checkbox"
                        name="area[]"
                        data-type="${slug}"
                        id="area-${slug}"
                        value="${label}"
                    >
                    <label for="area-${slug}">
                        ${label}
                    </label>
                </div>
                `
            );
        });
    }

    $(document).on("change",".ch-item input",function() {
        const $input = $(this);
        const type    = $input.data('type');
        const value   = $input.val();
        const label   = $input.siblings('label').text().trim();
        const isRadio = $input.attr('type') === 'radio';

        // 🚫 bedrooms handled separately
        if (type.includes( 'bedrooms' ) ) return;
        if (type.includes( 'resort' ) ) {
            var base_area = $('.filter-accordion.base_area');
            var area_label = $( this ).siblings('label').text().trim().toLowerCase();
            get_base_area( area_label );
            base_area.show();
        }

        if ($input.is(':checked')) {
            upsertSelectedFilter({
                type,
                value,
                label,
                single: isRadio
            });
        } else if (!isRadio) {
            removeSelectedFilter( type, value );
        }
    });

    $('#price_min, #price_max').on('input change', function () {

        const min = $('#price_min').val();
        const max = $('#price_max').val();

        // Keep labels in sync (you already do this, but safe)
        // $('#price-min-label').text(Number(min).toLocaleString());
        // $('#price-max-label').text(Number(max).toLocaleString());

        updatePriceFilter(min, max);
    });


    // Init on load
    if( 
        $('input[name="checkin"]').val().length > 0 && 
        $('input[name="checkout"]').val().length > 0
    ){
        console.log( 'Running initial search with dates' );
        runSearch(1);
    }
    else{
        console.log( 'Running initial search without dates' );
    }

    updatePriceRange();
    initSelectedFiltersFromInputs();
});
/*end jquery*/
    // Remove single selected filter
document.addEventListener('click', function (e) {
    if (!e.target.classList.contains('close_filter')) return;

    const filterEl = e.target.closest('.filter');
    const tab = filterEl.querySelector('.filter-tab');

    const type  = tab.dataset.type;
    const value = tab.dataset.value;

        // Uncheck corresponding input(s)
    document.querySelectorAll(
`.ch-item input[name="${type}"], .ch-item input[value="${value}"]`
).forEach(input => {
    input.checked = false;
    input.dispatchEvent(new Event('change'));
});

filterEl.remove();
});


</script>